<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LOGIN</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
    body {
      background-color: white;
    }
    .custom-navbar, .custom-footer {
      background-color: #a6a6ff; 
    }
    .login-box {
      background-color: #a6a6ff;
      padding: 30px;
      border-radius: 20px;
      width: 350px;
      margin: auto;
      margin-top: 80px;
    }
    .form-control {
      border-radius: 20px;
    }
    .custom-footer {
      position: fixed;
      bottom: 0;
      width: 100%;
      text-align: center;
      padding: 10px;
      font-size: 14px;
    }
    .btn {
      padding: 10px 20px;
      border: none;
      color: white;
      border-radius: 5px;
      cursor: pointer;
      margin: 5px;
    }
  </style>
</head>
<body>
    <nav class="navbar custom-navbar">
        <div  class="container-fluid">
            <span class="navbar-brand fw-bold">Inicio</span>
            <span class="navbar-text">Login</span>
        </div>
    </nav>
    
    <div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="login-box text-center">
            <h2 class="fw-bold mb-3">Login</h2>
            <form name="login" id="login" action=" "  method="POST">
                <div class="mb-3 text-start">
                  <label for="email" class="form-label">Email</label>
                  <input type="email" class="form-control" id="email" placeholder="Ingrese su correo">
                </div>
                <div class="mb-3 text-start" >
                  <label for="password" class="form-label">Password</label>
                  <input type="password" class="form-control" id="password" placeholder="Ingrese su contraseña">
                </div>
                <div style="float: center;" >
                    <button  type="submit" class="btn btn-success rounded" style="background-color:#75628A">Ingresar</button>
                </div>
            </form>
        </div>
            <footer class="custom-footer">
                Todos los derechos reservados Grupo #2
            </footer>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </div>

</body>
</html>