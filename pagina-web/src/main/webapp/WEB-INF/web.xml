<?xml version="1.0" encoding="UTF-8"?>
<web-app version="4.0"
         xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd">

  <display-name>Archetype Created Web Application</display-name>

  <!-- LOGIN (JSP dentro de WEB-INF) -->
  <servlet>
    <servlet-name>login</servlet-name>
    <jsp-file>/WEB-INF/views/login/index.jsp</jsp-file>
  </servlet>
  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <!-- Registros -->
  <servlet>
    <servlet-name>RegistersController</servlet-name>
    <servlet-class>com.umg.controllers.RegistersController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RegistersController</servlet-name>
    <url-pattern>/registers</url-pattern>
  </servlet-mapping>

  <!-- ROOMS -> Controller -->
  <servlet>
    <servlet-name>RoomsController</servlet-name>
    <servlet-class>com.umg.controllers.RoomsController</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>RoomsController</servlet-name>
    <url-pattern>/rooms</url-pattern>
  </servlet-mapping>


  <!-- GUESTS -> Controller -->
  <servlet>
    <servlet-name>GuestsController</servlet-name>
    <servlet-class>com.umg.controllers.GuestsController</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>GuestsController</servlet-name>
    <url-pattern>/guests</url-pattern>
  </servlet-mapping>

  <!-- Facturación -->
  <servlet>
    <servlet-name>BillsController</servlet-name>
    <servlet-class>com.umg.controllers.BillsController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>BillsController</servlet-name>
    <url-pattern>/billing</url-pattern>
  </servlet-mapping>


  <!-- AUTH CONTROLLER -->
  <servlet>
    <servlet-name>AuthController</servlet-name>
    <servlet-class>com.umg.controllers.AuthController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AuthController</servlet-name>
    <url-pattern>/auth</url-pattern>
  </servlet-mapping>

<!-- RESERVATIONS -->
<servlet>
  <servlet-name>ReservationsController</servlet-name>
  <servlet-class>com.umg.controllers.ReservationsController</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>ReservationsController</servlet-name>
  <url-pattern>/reservations</url-pattern>
</servlet-mapping>

  <!-- DASHBOARD -> Controller (NO <jsp-file> aquí) -->
  <servlet>
    <servlet-name>DashboardController</servlet-name>
    <servlet-class>com.umg.controllers.DashboardController</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>DashboardController</servlet-name>
    <url-pattern>/dashboard</url-pattern>
  </servlet-mapping>

  <!-- DASHBOARD -> Controller (NO <jsp-file> aquí) -->
  <servlet>
    <servlet-name>HistoryController</servlet-name>
    <servlet-class>com.umg.controllers.HistoryController</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>HistoryController</servlet-name>
    <url-pattern>/history</url-pattern>
  </servlet-mapping>

</web-app>
