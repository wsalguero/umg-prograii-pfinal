<%
  String active = (String)request.getAttribute("active");
  if (active == null) active = "";
%>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" href="<%=request.getContextPath()%>/home">HotelesApp</a>
    <ul class="navbar-nav ms-auto">
      <li class="nav-item"><a class="nav-link <%= "hoteles".equals(active)?"active":"" %>" href="#">Hoteles</a></li>
      <li class="nav-item"><a class="nav-link <%= "reportes".equals(active)?"active":"" %>" href="#">Reportes</a></li>
      <li class="nav-item"><a class="nav-link <%= "config".equals(active)?"active":"" %>" href="#">Configuración</a></li>
    </ul>
  </div>
</nav>
