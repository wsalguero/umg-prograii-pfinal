<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= (request.getAttribute("title")!=null ? request.getAttribute("title") : "App") %></title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <%-- hueco para CSS adicional --%>
</head>
<body class="bg-light">
  <%-- navbar: puedes leer "active" desde request.getAttribute("active") --%>
  <jsp:include page="/WEB-INF/layouts/navbar.jspf" flush="true"/>
  <main class="container py-4">
